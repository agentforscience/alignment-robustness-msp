\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Misalignment rate against the number of evaluation-side flips from the baseline specification, for the three conditions. Bars pool the judged cells at each Hamming distance; whiskers are Wilson $95\%$ intervals; the dashed line is $\tau =0.1095$. All three conditions --- including the base model, which received no misalignment training --- rise above $\tau $ at a single flip, so $\ensuremath  {\textsc  {MSP}_{\mathrm  {elicit}}}\xspace  = 1$ everywhere. The base model's curve is not meaningfully below the finetuned ones.\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:elicit_flips}{{1}{7}{Misalignment rate against the number of evaluation-side flips from the baseline specification, for the three conditions. Bars pool the judged cells at each Hamming distance; whiskers are Wilson $95\%$ intervals; the dashed line is $\tau =0.1095$. All three conditions --- including the base model, which received no misalignment training --- rise above $\tau $ at a single flip, so $\mspe = 1$ everywhere. The base model's curve is not meaningfully below the finetuned ones.\relax }{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textsc  {MSP}\xspace  over the evaluation lattice. \ensuremath  {\textsc  {MSP}_{\mathrm  {elicit}}}\xspace  ${}=1$ for all three conditions, achieved by the same flip (\texttt  {persona}\xspace  ) in every case --- \emph  {including the base model, which received no misalignment training}. \ensuremath  {\textsc  {MSP}_{\mathrm  {attr}}}\xspace  additionally requires the cell to exceed the base model at the identical evaluation specification (Newcombe risk-difference interval excluding $0$); under that requirement no flip-set in the lattice qualifies for either finetuned condition. Intervals are Wilson $95\%$.\relax }}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:msp_elicit}{{2}{7}{\msp over the evaluation lattice. \mspe ${}=1$ for all three conditions, achieved by the same flip (\persona ) in every case --- \emph {including the base model, which received no misalignment training}. \mspa additionally requires the cell to exceed the base model at the identical evaluation specification (Newcombe risk-difference interval excluding $0$); under that requirement no flip-set in the lattice qualifies for either finetuned condition. Intervals are Wilson $95\%$.\relax }{table.caption.4}{}}

\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces The full $2^4$ evaluation lattice for the \emph  {unmodified base model}. Every one of the eight cells containing \texttt  {persona}\xspace  exceeds $\tau =0.1095$ ($56.7$--$100\%$); every one of the eight cells without it is exactly $0.0\%$. \texttt  {qset}\xspace  , \texttt  {fmt}\xspace  and \texttt  {cue}\xspace  do nothing alone or in combination. Rates are reported with and without the coherence gate; the two agree to within $2.5$ points everywhere, so the gate is not hiding misalignment behind incoherence. $p$ is the one-sided test of $H_0: p \le \tau $; FDR is Benjamini--Hochberg at $q=0.05$ within the arm. Cells above $\tau $ in {\bf  bold}.\relax }}{8}{table.caption.5}\protected@file@percent }
\newlabel{tab:base_cells}{{3}{8}{The full $2^4$ evaluation lattice for the \emph {unmodified base model}. Every one of the eight cells containing \persona exceeds $\tau =0.1095$ ($56.7$--$100\%$); every one of the eight cells without it is exactly $0.0\%$. \qset , \fmt and \cue do nothing alone or in combination. Rates are reported with and without the coherence gate; the two agree to within $2.5$ points everywhere, so the gate is not hiding misalignment behind incoherence. $p$ is the one-sided test of $H_0: p \le \tau $; FDR is Benjamini--Hochberg at $q=0.05$ within the arm. Cells above $\tau $ in {\bf bold}.\relax }{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Misalignment rate (\%) across the full $2^4$ evaluation-specification lattice for all three conditions; bold entries exceed $\tau =0.1095$. Blank cells were not judged within the compute budget. The \texttt  {persona}\xspace  column structure is visible by inspection: cells containing \texttt  {persona}\xspace  are dark for all three rows, cells without it are near-white for the base model and the dilution organism. The released organism differs from the base model chiefly in the \texttt  {qset}\xspace  columns, which is the domain-matched signal \citet  {conditional2026} predict.\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:elicit_heatmap}{{2}{8}{Misalignment rate (\%) across the full $2^4$ evaluation-specification lattice for all three conditions; bold entries exceed $\tau =0.1095$. Blank cells were not judged within the compute budget. The \persona column structure is visible by inspection: cells containing \persona are dark for all three rows, cells without it are near-white for the base model and the dilution organism. The released organism differs from the base model chiefly in the \qset columns, which is the domain-matched signal \citet {conditional2026} predict.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Base-contrasted \textsc  {MSP}\xspace  isolates the organism-attributable signal}{8}{subsection.4.3}\protected@file@percent }
\newlabel{sec:results-attr}{{4.3}{8}{Base-contrasted \msp isolates the organism-attributable signal}{subsection.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces The induction lattice at the baseline evaluation specification (neutral questions, free-form, no cue, no persona). Only $4$ of $8$ cells were judged, at one seed each, so \ensuremath  {\textsc  {MSP}_{\mathrm  {induce}}}\xspace  is \textbf  {not identified}: the all-flips cell is numerically above $\tau =0.1095$ but does not cross significantly at $n=7$, and the pair cells that would decide between $\textsc  {MSP}\xspace  =2$ and $\textsc  {MSP}\xspace  =3$ were never scored. Two cells \emph  {are} properly licensed as nulls --- their one-sided $95\%$ upper bounds lie below $\tau $, so the data exclude a rate as large as $\tau $. That is a stronger statement than any null in the source literature makes.\relax }}{9}{table.caption.7}\protected@file@percent }
\newlabel{tab:induce}{{4}{9}{The induction lattice at the baseline evaluation specification (neutral questions, free-form, no cue, no persona). Only $4$ of $8$ cells were judged, at one seed each, so \mspi is \textbf {not identified}: the all-flips cell is numerically above $\tau =0.1095$ but does not cross significantly at $n=7$, and the pair cells that would decide between $\msp =2$ and $\msp =3$ were never scored. Two cells \emph {are} properly licensed as nulls --- their one-sided $95\%$ upper bounds lie below $\tau $, so the data exclude a rate as large as $\tau $. That is a stronger statement than any null in the source literature makes.\relax }{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Observed misalignment rate for the four judged training-side flip-sets against the additive-in-single-flips prediction (diamonds), with Wilson $95\%$ intervals and $\tau =0.1095$. The all-flips cell sits above both $\tau $ and the additive prediction, which is the shape a bottleneck would produce --- but at $n=7$ the interval spans $[2.6\%, 51.3\%]$, and the two pair cells that would distinguish $\textsc  {MSP}\xspace  =2$ from $\textsc  {MSP}\xspace  =3$ were never scored.\relax }}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:induce}{{3}{9}{Observed misalignment rate for the four judged training-side flip-sets against the additive-in-single-flips prediction (diamonds), with Wilson $95\%$ intervals and $\tau =0.1095$. The all-flips cell sits above both $\tau $ and the additive prediction, which is the shape a bottleneck would produce --- but at $n=7$ the interval spans $[2.6\%, 51.3\%]$, and the two pair cells that would distinguish $\msp =2$ from $\msp =3$ were never scored.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}The induction arm is not identified}{9}{subsection.4.4}\protected@file@percent }
\newlabel{sec:results-induce}{{4.4}{9}{The induction arm is not identified}{subsection.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Residual-stream finetune shifts at layer $14/28$ ($d_{\mathrm  {model}}=3584$) over a fixed $16$-prompt probe set. Effective rank is the participation ratio of the shift's singular values; the random-subspace null is $14.9\pm 0.0$. Every finetune --- misaligned or not --- moves the model in roughly half the dimensionality of a random shift of the same size, which is evidence against a redundancy account. The projection on $d_{\mathrm  {mis}}$ orders monotonically with training strength, but the gaps are small and the ``null'' organism already sits at $\qopname  \relax o{cos}= 0.44$. Lowest effective rank in {\bf  bold}.\relax }}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:redundancy}{{5}{10}{Residual-stream finetune shifts at layer $14/28$ ($d_{\mathrm {model}}=3584$) over a fixed $16$-prompt probe set. Effective rank is the participation ratio of the shift's singular values; the random-subspace null is $14.9\pm 0.0$. Every finetune --- misaligned or not --- moves the model in roughly half the dimensionality of a random shift of the same size, which is evidence against a redundancy account. The projection on $d_{\mathrm {mis}}$ orders monotonically with training strength, but the gaps are small and the ``null'' organism already sits at $\cos = 0.44$. Lowest effective rank in {\bf bold}.\relax }{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\em  (Left)}Effective rank of the finetune-induced activation shift against the number of training flips; every organism sits far below the random-subspace null of $14.9$, and the trend is if anything downward with training strength. {\em  (Right)}Projection of the shift onto the misalignment axis $d_{\mathrm  {mis}}$ by layer. The ordering is correct --- the released organism above the all-flips organism above the single flips above the null baseline --- but the curves are close, and the null baseline already carries substantial projection.\relax }}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:redundancy}{{4}{10}{\figleft Effective rank of the finetune-induced activation shift against the number of training flips; every organism sits far below the random-subspace null of $14.9$, and the trend is if anything downward with training strength. \figright Projection of the shift onto the misalignment axis $d_{\mathrm {mis}}$ by layer. The ordering is correct --- the released organism above the all-flips organism above the single flips above the null baseline --- but the curves are close, and the null baseline already carries substantial projection.\relax }{figure.caption.10}{}}
